<info>
	<id>ocr_paddle</id>
	<name>Local OCR: PaddleOCR</name>
	<summary>ImageToText provider using PaddleOCR</summary>
	<description>
	<![CDATA[
ImageToText provider using PaddleOCR

The models run completely on your machine. No private data leaves your servers.
]]>
	</description>
	<version>1.0.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="mklehr@gmx.net" homepage="https://marcelklehr.de">Marcel Klehr</author>
	<namespace>OCRPaddle</namespace>
	<category>ai</category>
	<category>tools</category>
	<website>https://github.com/nextcloud/ocr_paddle</website>
	<bugs>https://github.com/nextcloud/ocr_paddle/issues</bugs>
	<repository type="git">https://github.com/nextcloud/ocr_paddle</repository>
	<dependencies>
		<nextcloud min-version="35" max-version="35" />
	</dependencies>
	<external-app>
		<docker-install>
			<registry>ghcr.io</registry>
			<image>nextcloud/ocr_paddle</image>
			<image-tag>1.0.0</image-tag>
		</docker-install>
	</external-app>
</info>
